# ========== 应用配置 ==========
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ========== MySQL 数据库配置 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=agentic_rag

# ========== Redis 配置（可选，暂时跳过） ==========
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ========== Milvus 配置（可选，暂时跳过） ==========
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION_NAME=knowledge_chunks

# ========== 对象存储配置（可选，暂时跳过） ==========
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=veritas-rag-docs
# S3_REGION=us-east-1

# ========== Qwen 模型配置 ==========
# 通义千问 API
LLM_PROVIDER=qwen
LLM_API_KEY=your_qwen_api_key_here
LLM_MODEL=qwen-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ========== Qwen Embedding 配置 ==========
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_qwen_api_key_here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# ========== Qwen Reranker 配置 ==========
RERANKER_PROVIDER=qwen
RERANKER_API_KEY=your_qwen_api_key_here
RERANKER_MODEL=qwen-reranker

# ========== Vision/OCR 配置 ==========
VISION_PROVIDER=qwen
VISION_API_KEY=your_qwen_api_key_here
VISION_MODEL=qwen-vl-max

# ========== 联网搜索配置（可选） ==========
WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_API_KEY=

# ========== 安全配置 ==========
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========== 可观测性配置 ==========
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=veritas-rag
